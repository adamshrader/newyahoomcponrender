import { URLSearchParams } from "node:url";

const API_BASE = process.env.YAHOO_API_BASE ?? "https://fantasysports.yahooapis.com/fantasy/v2";
const TOKEN_URL = "https://api.login.yahoo.com/oauth2/get_token";
const AUTH_URL = "https://api.login.yahoo.com/oauth2/request_auth";

export type YahooToken = {
  access_token: string;
  refresh_token: string;
  expires_at: number;
};

export function yahooAuthorizationUrl(args: {
  redirectUri: string;
  state: string;
}) {
  const p = new URLSearchParams({
    client_id: required("YAHOO_CLIENT_ID"),
    redirect_uri: args.redirectUri,
    response_type: "code",
    state: args.state
  });
  return `${AUTH_URL}?${p.toString()}`;
}

export async function exchangeYahooCode(code: string, redirectUri: string): Promise<YahooToken> {
  const body = new URLSearchParams({
    client_id: required("YAHOO_CLIENT_ID"),
    client_secret: required("YAHOO_CLIENT_SECRET"),
    redirect_uri: redirectUri,
    code,
    grant_type: "authorization_code"
  });

  const res = await fetch(TOKEN_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body
  });
  if (!res.ok) throw new Error(`Yahoo token exchange failed: ${res.status} ${await res.text()}`);
  const data = await res.json() as { access_token: string; refresh_token: string; expires_in: number };
  return { ...data, expires_at: Date.now() + data.expires_in * 1000 };
}

export async function refreshYahooToken(refreshToken: string): Promise<YahooToken> {
  const body = new URLSearchParams({
    client_id: required("YAHOO_CLIENT_ID"),
    client_secret: required("YAHOO_CLIENT_SECRET"),
    redirect_uri: yahooCallbackUrl(),
    refresh_token: refreshToken,
    grant_type: "refresh_token"
  });

  const res = await fetch(TOKEN_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body
  });
  if (!res.ok) throw new Error(`Yahoo token refresh failed: ${res.status} ${await res.text()}`);
  const data = await res.json() as { access_token: string; expires_in: number; refresh_token?: string };
  return {
    access_token: data.access_token,
    refresh_token: data.refresh_token ?? refreshToken,
    expires_at: Date.now() + data.expires_in * 1000
  };
}

export function yahooCallbackUrl() {
  return `${required("PUBLIC_BASE_URL")}/oauth/yahoo/callback`;
}

export async function yahooGet(path: string, token: string): Promise<unknown> {
  if (!path.startsWith("/")) path = `/${path}`;
  if (!path.startsWith("/users;") && !path.startsWith("/user/") && !path.startsWith("/league/") &&
      !path.startsWith("/team/") && !path.startsWith("/player/") && !path.startsWith("/game/")) {
    throw new Error("Path must be a Yahoo Fantasy API resource path.");
  }

  const url = new URL(API_BASE + path);
  url.searchParams.set("format", "json");

  const res = await fetch(url, {
    method: "GET",
    headers: { Authorization: `Bearer ${token}`, Accept: "application/json" }
  });

  if (!res.ok) throw new Error(`Yahoo API GET failed: ${res.status} ${await res.text()}`);
  return await res.json();
}

function required(name: string): string {
  const value = process.env[name];
  if (!value) throw new Error(`Missing environment variable: ${name}`);
  return value;
}

import "dotenv/config";
import express from "express";
import crypto from "node:crypto";
import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
import { z } from "zod";
import { SignJWT, jwtVerify } from "jose";
import {
  exchangeYahooCode,
  refreshYahooToken,
  yahooAuthorizationUrl,
  yahooCallbackUrl,
  yahooGet,
  type YahooToken
} from "./yahoo.js";

const app = express();
app.use(express.json({ limit: "1mb" }));

const base = required("PUBLIC_BASE_URL").replace(/\/$/, "");
const secret = new TextEncoder().encode(required("MCP_JWT_SECRET"));

type OAuthRequest = {
  client_id: string;
  redirect_uri: string;
  response_type: string;
  state?: string;
  code_challenge?: string;
  code_challenge_method?: string;
};

type SessionClaims = {
  sid: string;
  sub: string;
};

type StoredSession = {
  refreshToken: string;
};

const sessions = new Map<string, StoredSession>();

const pending = new Map<string, OAuthRequest>();
const authCodes = new Map<string, { request: OAuthRequest; token: YahooToken; expires: number }>();

function newId() {
  return crypto.randomBytes(32).toString("hex");
}

async function signSession(sessionId: string) {
  return new SignJWT({ sid: sessionId, sub: "yahoo-user" })
    .setProtectedHeader({ alg: "HS256" })
    .setIssuedAt()
    .setExpirationTime("30d")
    .sign(secret);
}

async function verifySession(auth: string): Promise<SessionClaims> {
  if (!auth?.startsWith("Bearer ")) throw new Error("Missing bearer token");
  const { payload } = await jwtVerify(auth.slice(7), secret);
  if (typeof payload.sid !== "string" || typeof payload.sub !== "string") throw new Error("Invalid token");
  if (!sessions.has(payload.sid)) throw new Error("Session expired; reconnect Yahoo in ChatGPT");
  return { sid: payload.sid, sub: payload.sub };
}

async function getYahooAccess(session: SessionClaims): Promise<string> {
  const stored = sessions.get(session.sid);
  if (!stored) throw new Error("Session expired; reconnect Yahoo in ChatGPT");
  const t = await refreshYahooToken(stored.refreshToken);
  stored.refreshToken = t.refresh_token;
  return t.access_token;
}

function mcpServer(session: SessionClaims) {
  const server = new McpServer(
    { name: "yahoo-fantasy-readonly", version: "2.0.0" },
    { instructions: "Yahoo Fantasy access is strictly read-only. Never attempt writes." }
  );

  const get = async (path: string) => yahooGet(path, await getYahooAccess(session));

  server.tool("yahoo_leagues", "Read the Yahoo leagues available to the authenticated user.", {}, async () =>
    result(await get("/users;use_login=1/games;game_keys=nfl/leagues"))
  );

  server.tool("yahoo_teams", "Read the authenticated user's Yahoo Fantasy teams.", {
    game_key: z.string().optional().describe("Yahoo game key, e.g. nfl")
  }, async ({ game_key }) =>
    result(await get(`/users;use_login=1/games;game_keys=${encodeURIComponent(game_key ?? "nfl")}/teams`))
  );

  server.tool("yahoo_roster", "Read a Yahoo Fantasy team's roster for a week.", {
    team_key: z.string().describe("Yahoo team key"),
    week: z.string().optional().describe("NFL fantasy week")
  }, async ({ team_key, week }) =>
    result(await get(`/team/${encodeURIComponent(team_key)}/roster${week ? `;week=${encodeURIComponent(week)}` : ""}`))
  );

  server.tool("yahoo_standings", "Read standings for a Yahoo Fantasy league.", {
    league_key: z.string().describe("Yahoo league key")
  }, async ({ league_key }) => result(await get(`/league/${encodeURIComponent(league_key)}/standings`)));

  server.tool("yahoo_matchups", "Read scoreboard/matchup information for a Yahoo Fantasy league.", {
    league_key: z.string().describe("Yahoo league key"),
    week: z.string().optional().describe("Fantasy week")
  }, async ({ league_key, week }) =>
    result(await get(`/league/${encodeURIComponent(league_key)}/scoreboard${week ? `;week=${encodeURIComponent(week)}` : ""}`))
  );

  server.tool("yahoo_players", "Read players from a Yahoo Fantasy league.", {
    league_key: z.string().describe("Yahoo league key"),
    status: z.string().optional().describe("Optional player status filter")
  }, async ({ league_key, status }) =>
    result(await get(`/league/${encodeURIComponent(league_key)}/players${status ? `;status=${encodeURIComponent(status)}` : ""}`))
  );

  server.tool("yahoo_player", "Read a specific Yahoo Fantasy player.", {
    player_key: z.string().describe("Yahoo player key")
  }, async ({ player_key }) => result(await get(`/player/${encodeURIComponent(player_key)}`)));

  server.tool("yahoo_transactions", "Read league transactions.", {
    league_key: z.string().describe("Yahoo league key"),
    type: z.string().optional().describe("Optional transaction type filter")
  }, async ({ league_key, type }) =>
    result(await get(`/league/${encodeURIComponent(league_key)}/transactions${type ? `;type=${encodeURIComponent(type)}` : ""}`))
  );

  server.tool("yahoo_draft_results", "Read draft results for a Yahoo Fantasy league.", {
    league_key: z.string().describe("Yahoo league key")
  }, async ({ league_key }) => result(await get(`/league/${encodeURIComponent(league_key)}/draftresults`)));

  server.tool("yahoo_get", "Read any supported Yahoo Fantasy API resource using HTTP GET only.", {
    path: z.string().describe("Yahoo Fantasy API path beginning with /users, /user, /league, /team, /player, or /game")
  }, async ({ path }) => result(await get(path)));

  return server;
}

function result(data: unknown) {
  return { content: [{ type: "text" as const, text: JSON.stringify(data, null, 2) }] };
}

// OAuth metadata for ChatGPT.
app.get("/.well-known/oauth-authorization-server", (_req, res) => {
  res.json({
    issuer: base,
    authorization_endpoint: `${base}/oauth/authorize`,
    token_endpoint: `${base}/oauth/token`,
    registration_endpoint: `${base}/oauth/register`,
    response_types_supported: ["code"],
    grant_types_supported: ["authorization_code"],
    code_challenge_methods_supported: ["S256"],
    token_endpoint_auth_methods_supported: ["none", "client_secret_post"]
  });
});

app.get("/.well-known/oauth-protected-resource", (_req, res) => {
  res.json({
    resource: `${base}/mcp`,
    authorization_servers: [base],
    scopes_supported: ["fantasy.read"]
  });
});

app.post("/oauth/register", (_req, res) => {
  res.status(201).json({
    client_id: `chatgpt-${newId()}`,
    client_secret: newId(),
    client_id_issued_at: Math.floor(Date.now() / 1000),
    redirect_uris: []
  });
});

app.get("/oauth/authorize", (req, res) => {
  const q = req.query as Record<string, string | undefined>;
  if (!q.client_id || !q.redirect_uri || q.response_type !== "code") {
    return res.status(400).send("Invalid OAuth authorization request.");
  }
  const request: OAuthRequest = {
    client_id: q.client_id,
    redirect_uri: q.redirect_uri,
    response_type: q.response_type,
    state: q.state,
    code_challenge: q.code_challenge,
    code_challenge_method: q.code_challenge_method
  };
  const state = newId();
  pending.set(state, request);
  const url = yahooAuthorizationUrl({ redirectUri: yahooCallbackUrl(), state });
  res.redirect(url);
});

app.get("/oauth/yahoo/callback", async (req, res) => {
  try {
    const state = String(req.query.state ?? "");
    const code = String(req.query.code ?? "");
    const request = pending.get(state);
    pending.delete(state);
    if (!request || !code) return res.status(400).send("Invalid Yahoo OAuth callback.");

    const token = await exchangeYahooCode(code, yahooCallbackUrl());
    const authCode = newId();
    authCodes.set(authCode, { request, token, expires: Date.now() + 5 * 60_000 });

    const redirect = new URL(request.redirect_uri);
    redirect.searchParams.set("code", authCode);
    if (request.state) redirect.searchParams.set("state", request.state);
    res.redirect(redirect.toString());
  } catch (e) {
    res.status(500).send(errorMessage(e));
  }
});

app.post("/oauth/token", async (req, res) => {
  const code = String(req.body.code ?? "");
  const verifier = String(req.body.code_verifier ?? "");
  const record = authCodes.get(code);
  authCodes.delete(code);
  if (!record || record.expires < Date.now()) return res.status(400).json({ error: "invalid_grant" });

  if (record.request.code_challenge) {
    const digest = crypto.createHash("sha256").update(verifier).digest("base64url");
    if (digest !== record.request.code_challenge) return res.status(400).json({ error: "invalid_grant" });
  }

  const sessionId = newId();
  sessions.set(sessionId, { refreshToken: record.token.refresh_token });
  const access = await signSession(sessionId);
  res.json({
    access_token: access,
    token_type: "Bearer",
    expires_in: 30 * 24 * 3600,
    scope: "fantasy.read"
  });
});

app.get("/health", (_req, res) => res.json({ ok: true, read_only: true }));

app.post("/mcp", async (req, res) => {
  try {
    const session = await verifySession(req.headers.authorization ?? "");
    const server = mcpServer(session);
    const transport = new StreamableHTTPServerTransport({
      sessionIdGenerator: undefined,
      enableJsonResponse: true
    });
    res.on("close", () => transport.close());
    await server.connect(transport);
    await transport.handleRequest(req, res, req.body);
  } catch (e) {
    res.status(401).json({ error: "unauthorized", message: errorMessage(e) });
  }
});

app.get("/mcp", (_req, res) => {
  res.status(405).json({ error: "GET not supported; use MCP POST" });
});

const port = Number(process.env.PORT ?? 3000);
app.listen(port, "0.0.0.0", () => {
  console.log(`Yahoo Fantasy read-only MCP listening on ${port}`);
});

function required(name: string): string {
  const v = process.env[name];
  if (!v) throw new Error(`Missing environment variable: ${name}`);
  return v;
}

function errorMessage(e: unknown): string {
  return e instanceof Error ? e.message : String(e);
}
